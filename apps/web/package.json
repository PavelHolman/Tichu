{
  "name": "@tichu/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types --check && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "wrangler types",
    "typecheck": "wrangler types >/dev/null && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@tichu/engine": "workspace:*",
    "@tichu/protocol": "workspace:*",
    "effect": "4.0.0-rc.115",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.115",
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.0",
    "@lucide/svelte": "1.47.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.63.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.0",
    "bits-ui": "2.18.0",
    "cn": "0.3.0",
    "shadcn-svelte": "1.7.0",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "4.133.0"
  }
}
