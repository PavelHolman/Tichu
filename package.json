{
  "name": "tichu",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "dev:table": "bun run --cwd apps/table dev",
    "dev:web": "bun run --cwd apps/web dev",
    "test:integration": "bun run --cwd apps/table test:integration"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-plugin-eslint": "1.83.0",
    "temporal-polyfill": "1.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,js,mts,cts,svelte}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,yaml,yml,css,md}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
